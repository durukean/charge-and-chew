<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- EV charging is one of Apple's named CarPlay categories. Apple grants this per app on
       request; a device build WITHOUT the grant fails to sign, which is why project.yml
       applies this file to Debug (simulator) builds only until the grant lands. -->
  <key>com.apple.developer.carplay-charging</key>
  <true/>
</dict>
</plist>
