.DS_Store
data/allSites.json
data/afdc_raw.json

mockups/

# iOS: the Xcode project is generated from ios/project.yml -- run `xcodegen generate
# --spec ios/project.yml --project ios`. Committing it would mean resolving pbxproj
# conflicts by hand for no benefit. Web/ is a copy made by ios/sync-web.sh.
ios/build/
ios/ChargeAndChew.xcodeproj/
ios/ChargeAndChew/Web/
# Generated by xcodegen from ios/project.yml. Tracking it invites hand-edits, which get
# silently overwritten on the next generate -- that cost a black-screen debugging session.
ios/ChargeAndChew/Info.plist

# Raw simulator screen recordings (multi-MB, regenerable). The encoded App Store
# preview -- ios/preview/preview.mov -- is committed; the raw take is not.
ios/preview/raw.mov

# Scratch pages the browser test suites write and delete; never commit them.
_hours_probe.html
__search_probe.html
__perf.html

# Release outputs from ios/release.sh: the signed .ipa, the Xcode archive (dSYMs, development
# provisioning profiles listing device UDIDs) and export logs. These were committed for a while
# and, because Pages served the repo root, downloadable from chargeandchew.com. Never again.
ios/ChargeAndChew.xcarchive/
ios/export/
# App Store Connect key ID / issuer / .p8 path (read by tools/asc.js and ios/release.sh).
.asc.env
# Output of publish.py: the only thing GitHub Pages serves.
_site/
__seed_storage.html
